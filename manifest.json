{
	"manifest_version": 2.0,
	"id": "zbxviewconnect",
	"type": "module",
	"name": "ZbxView connect",
	"namespace": "ZbxViewConnect",
	"version": "1.5.0",
	"author": "Radek Pavlík",
	"url": "https://github.com/RadekPavlik/Zabbix-UI-Modules-ZbxView-connect",
	"description": "Pairs the ZbxView / Zabbix mobile app with a QR code: one API token per phone, never expiring once the phone has used it; a code nobody scans in 5 minutes is dropped again.",
	"actions": {
		"zbxview.connect": {
			"class": "ConnectView",
			"view": "connect.view",
			"layout": "layout.htmlpage"
		},
		"zbxview.connect.create": {
			"class": "ConnectCreate",
			"layout": "layout.json"
		},
		"zbxview.connect.settings": {
			"class": "SettingsView",
			"view": "settings.view",
			"layout": "layout.htmlpage"
		},
		"zbxview.connect.settings.update": {
			"class": "SettingsUpdate",
			"layout": "layout.json"
		}
	},
	"assets": {
		"css": [
			"menu.css"
		],
		"js": []
	},
	"config": {
		"url": "",
		"name": "",
		"self_signed": "auto",
		"client_cert": "",
		"client_cert_password": "",
		"client_cert_hosts": "",
		"client_cert_name": ""
	}
}
